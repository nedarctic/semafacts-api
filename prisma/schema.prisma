generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String?
  email        String        @unique
  password     String?
  role         UserRole?     @default(HANDLER)
  status       UserStatus?   @default(INACTIVE)
  refreshToken String?
  companyId    String?       @db.Uuid
  company      Company?      @relation(fields: [companyId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt()
  inviteTokens InviteToken[]
}

model Company {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  reportingLinkSlug String?
  slaDays           String?
  logoKey           String?
  logoUrl           String?
  users             User[]
  categories        Category[]
  reportingPage     ReportingPage?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt()
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  categoryName String
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, categoryName])
}

model ReportingPage {
  id               String  @id @default(uuid()) @db.Uuid
  companyId        String  @unique @db.Uuid
  title            String?
  introContent     String?
  policyUrl        String?
  reportingPageUrl String? @unique
  company          Company @relation(fields: [companyId], references: [id])
}

model InviteToken {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  log       String
  details   String
  createdAt DateTime @default(now())
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HANDLER
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum AttachmentUploader {
  Reporter
  Handler
}

enum SenderType {
  Reporter
  Handler
}

enum IncidentStatus {
  New
  InReview
  Investigation
  Resolved
  Closed
}

enum ReporterType {
  Anonymous
  Confidential
}
