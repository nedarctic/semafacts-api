generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  name         String?
  email        String      @unique
  password     String?
  role         UserRole?   @default(HANDLER)
  status       UserStatus? @default(INACTIVE)
  refreshToken String?
  companyId    String?     @db.Uuid
  company      Company?    @relation(fields: [companyId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt()
}

model Company {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  reportingLinkSlug String?
  slaDays           String?
  users             User[]
  categories        Category[]
  reportingPage     ReportingPage?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt()
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  categoryName String
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, categoryName])
}

model ReportingPage {
  id               String  @id @default(uuid()) @db.Uuid
  companyId        String  @unique @db.Uuid
  title            String?
  introContent     String?
  policyUrl        String?
  reportingPageUrl String? @unique
  company          Company @relation(fields: [companyId], references: [id])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HANDLER
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}
