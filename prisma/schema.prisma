generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  name             String?
  email            String            @unique
  password         String?
  role             UserRole?         @default(HANDLER)
  status           UserStatus?       @default(INACTIVE)
  refreshToken     String?
  companyId        String?           @db.Uuid
  company          Company?          @relation(fields: [companyId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt()
  inviteTokens     InviteToken[]
  messages         Message[]
  incidentHandlers IncidentHandler[]
}

model Company {
  id                String         @id @default(uuid()) @db.Uuid
  name              String         @unique
  reportingLinkSlug String?
  slaDays           String?
  logoKey           String?
  logoUrl           String?
  users             User[]
  categories        Category[]
  reportingPage     ReportingPage?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt()
  incidents         Incident[]
  auditLogs         AuditLog[]
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  categoryName String
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, categoryName])
}

model ReportingPage {
  id               String  @id @default(uuid()) @db.Uuid
  companyId        String  @unique @db.Uuid
  title            String?
  introContent     String?
  policyUrl        String?
  reportingPageUrl String? @unique
  company          Company @relation(fields: [companyId], references: [id])
}

model InviteToken {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  log        String
  details    String
  companyId  String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
  incidentId String?  @db.Uuid
}

model Incident {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @db.Uuid
  incidentIdDisplay String            @unique
  category          String
  description       String
  location          String
  involvedPeople    String?
  incidentDate      DateTime
  reporterType      ReporterType
  status            IncidentStatus
  secretCodeHash    String
  deadlineAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  closedAt          DateTime?
  duration          String?
  attachments       Attachment[]
  handlers          IncidentHandler[]
  company           Company           @relation(fields: [companyId], references: [id])
  messages          Message[]
  reporter          Reporter?
  secretCodes       SecretCode[]
}

model SecretCode {
  id             String   @id @default(uuid()) @db.Uuid
  incidentId     String   @db.Uuid
  secretCodeHash String
  createdAt      DateTime @default(now())
  incident       Incident @relation(fields: [incidentId], references: [id])
}

model Message {
  id         String     @id @default(uuid()) @db.Uuid
  incidentId String     @db.Uuid
  senderType SenderType
  content    String
  createdAt  DateTime   @default(now())
  reporterId String?    @db.Uuid
  userId     String?    @db.Uuid
  incident   Incident   @relation(fields: [incidentId], references: [id])
  reporter   Reporter?  @relation(fields: [reporterId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])
}

model Reporter {
  id         String    @id @default(uuid()) @db.Uuid
  incidentId String    @unique @db.Uuid
  name       String?
  email      String?
  phone      String?
  createdAt  DateTime  @default(now())
  messages   Message[]
  incident   Incident  @relation(fields: [incidentId], references: [id])
}

model IncidentHandler {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  handlerId  String   @db.Uuid
  assignedAt DateTime @default(now())
  handler    User     @relation(fields: [handlerId], references: [id])
  incident   Incident @relation(fields: [incidentId], references: [id])

  @@unique([incidentId, handlerId])
  @@map("incident_handlers")
}

model Attachment {
  id         String             @id @default(uuid()) @db.Uuid
  incidentId String             @db.Uuid
  uploadedBy AttachmentUploader
  fileKey    String
  fileUrl    String
  createdAt  DateTime           @default(now())
  incident   Incident           @relation(fields: [incidentId], references: [id])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HANDLER
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum AttachmentUploader {
  Reporter
  Handler
}

enum SenderType {
  Reporter
  Handler
}

enum IncidentStatus {
  New
  InReview
  Investigation
  Resolved
  Closed
}

enum ReporterType {
  Anonymous
  Confidential
}
